{
  "name": "md-airat",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create md-airat",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types && tsc --noEmit",
    "test:e2e": "wrangler d1 migrations apply DB --local && node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.4.1",
    "dompurify": "3.4.16",
    "esbuild": "0.28.1",
    "highlight.js": "11.12.0",
    "js-yaml": "5.4.2",
    "katex": "0.18.10",
    "markdown-it": "15.0.2",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-dollarmath": "0.5.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-front-matter": "0.2.4",
    "markdown-it-github-alerts": "1.0.1",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "mermaid": "12.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260930.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.4",
    "lodash-es": "^4.18.1",
    "markdown-it-dollarmath": {
      "markdown-it": "$markdown-it"
    }
  }
}
